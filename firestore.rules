rules_version = '2';
// Load Sheet crew database rules.
// Paste into Firebase console → Firestore Database → Rules, after replacing OWNER_EMAIL
// with the Google account that owns the project (all lowercase). Then tap Publish.
//
// Roles live in orgs/{org}/members/{email}: "driver", "office" or "admin".
//   driver: reads and writes only their own loads
//   office: reads and edits everyone's loads (office page)
//   admin:  office + manages the crew list
// The owner is always an admin, which is how the first crew entry gets created.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && myEmail() == 'OWNER_EMAIL'; }
    function memberPath(org) { return /databases/$(database)/documents/orgs/$(org)/members/$(myEmail()); }
    function isMember(org) { return signedIn() && exists(memberPath(org)); }
    function role(org) { return get(memberPath(org)).data.role; }
    function isOffice(org) { return isOwner() || (isMember(org) && role(org) in ['office', 'admin']); }
    function isAdmin(org) { return isOwner() || (isMember(org) && role(org) == 'admin'); }
    function mine() { return resource.data.driverUid == request.auth.uid; }
    function staysMine() { return request.resource.data.driverUid == request.auth.uid; }

    match /orgs/{org}/members/{email} {
      allow read: if signedIn() && (email == myEmail() || isOffice(org));
      allow write: if isAdmin(org);
    }

    match /orgs/{org}/records/{id} {
      allow read: if isOffice(org) || (isMember(org) && mine());
      allow create: if isMember(org) && staysMine();
      allow update: if isOffice(org) || (isMember(org) && mine() && staysMine());
      allow delete: if isOffice(org) || (isMember(org) && mine());
    }
  }
}
